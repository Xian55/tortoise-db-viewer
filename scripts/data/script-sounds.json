4,1250,1251,1252,1253]},"npc_weegli_blastfuse":{"b":[3744,3785,6067]},"npc_willix_the_importer":{"t":[-1047001,-1047002,-1047003,-1047004,-1047005,-1047006,-1047007,-1047008,-1047009,-1047010,-1047011,-1047012]},"npc_witch_doctor_mauari":{"t":[-1000651]},"npc_wizzlecranks_shredder":{"t":[-1000299,-1000300,-1000301,-1000302,-1000303,-1000304,-1000305]},"npc_worldboss_a_av":{"b":[8736]},"npc_worldboss_h_av":{"b":[8616,8618]},"npcs_riverbreeze_and_silversky":{"t":[-1000566,-1000567,-1000568,-1000569,-1000570]},"trigger_orb_of_command":{"t":[-1469035]},"zero_boss_razorgore":{"t":[-1469025],"s":[8272]}},"lines":{"6931":{"t":"I can't handle this suffering anymore...","s":["npc_frostbitten_bronze_soldier","npc_infinite_dragonspawn","npc_infinite_riftguard","npc_infinite_riftweaver","npc_infinite_whelp","npc_infinite_timeripper","npc_infinite_riftlord","npc_aqir_add","npc_swamp_mob","boss_chronar","boss_harbringer","boss_epochronos","npc_shade","npc_rotmaw","npc_mossheart","npc_antnormi","npc_logistical_officer"]},"8276":{"t":"You'll pay for forcing me to do this!","s":["instance_blackwing_lair","go_orbe_domination","go_oeuf_raz","go_engin_suppression","at_orb_of_command","at_enter_vael_room","npc_death_talon","npc_corrupted_whelp","npc_blackwing_technician"]},"8277":{"t":"Fools! These eggs are more precious than you know!","s":["instance_blackwing_lair","go_orbe_domination","go_oeuf_raz","go_engin_suppression","at_orb_of_command","at_enter_vael_room","npc_death_talon","npc_corrupted_whelp","npc_blackwing_technician"]},"30252":{"t":"We will serve at the Master's will!","s":["instance_crescent_grove"],"c":92111},"30253":{"t":"You think.. This.... Is the end?","s":["instance_crescent_grove"],"c":92111},"30256":{"t":"What? Who..Who are you? They wouldn't send you! Ancients, to my side!","s":["instance_crescent_grove"],"c":92109},"30258":{"t":"We must.. Stop.. The shadow...","s":["instance_crescent_grove"],"c":92109},"30268":{"t":"I am the leader of the tribes, me! The Groveweald shall destroy everyone that gets in the way!","s":["instance_crescent_grove"],"c":92107},"30270":{"t":"I.. I can see clearly now.. The madness... It's... Over...","s":["instance_crescent_grove"],"c":92107},"30271":{"t":"Do you think you can withstand the might of the Burning Legion?","s":["instance_crescent_grove"],"c":92110},"30273":{"t":"My death.. Means little in the grand scheme, mortals... Drink down your victory... It will mean nothing... In the end...","s":["instance_crescent_grove"],"c":92110},"60382":{"t":"Order must be maintained!","s":["instance_gilneas_city","genn_greymane","greymane_knight","greymane_noble"]},"60383":{"t":"I will not let Gilneas fall to madness, not while I...","s":["instance_gilneas_city","genn_greymane","greymane_knight","greymane_noble"]},"60384":{"t":"This district is currently on lockdown!","s":["instance_gilneas_city","genn_greymane","greymane_knight","greymane_noble"]},"60385":{"t":"Foolish interloper, you do not belong here...","s":["instance_gilneas_city","genn_greymane","greymane_knight","greymane_noble"]},"60386":{"t":"I have served as Marshal throughout all of the orcish incursions. You will not put an end to Gilneas.","s":["instance_gilneas_city","genn_greymane","greymane_knight","greymane_noble"]},"60387":{"t":"The brave defenders of this city... will not let you put it to ruin, outsider!","s":["instance_gilneas_city","genn_greymane","greymane_knight","greymane_noble"]},"60388":{"t":"My family has held power in Gilneas for countless generations. You will not change fate.","s":["instance_gilneas_city","genn_greymane","greymane_knight","greymane_noble"]},"60390":{"t":"It... it was pointless after all... This cannot be the way I fall...","s":["instance_gilneas_city","genn_greymane","greymane_knight","greymane_noble"]},"60391":{"t":"I hunt from the shadows, these streets have been cleared by my hand!","s":["instance_gilneas_city","genn_greymane","greymane_knight","greymane_noble"]},"60392":{"t":"This was not meant to be...","s":["instance_gilneas_city","genn_greymane","greymane_knight","greymane_noble"]},"60399":{"t":"All of our progress, our influence... What a pointless end...","s":["instance_gilneas_city","genn_greymane","greymane_knight","greymane_noble"]},"60400":{"t":"Mortimer, it would appear we have someone here to interrupt our plans!","s":["instance_gilneas_city","genn_greymane","greymane_knight","greymane_noble"]},"60402":{"t":"New guests? It has been a while since we have had those. I assume your arrival has taken -some- effort even if you were uninvited!","s":["boss_moroes"]},"60403":{"t":"Most impressive, it would appear your skills do match your bravery.","s":["boss_moroes"]},"60404":{"t":"Now now, why don't we save such pleasantries for a more, entertaining show. Meet me at the stage, and we shall truly decide the outcome of our engagement.","s":["boss_moroes"]},"60408":{"t":"Medivh, I have failed you...","s":["boss_moroes"]},"60409":{"t":"Whats this? You're here for the orb?! ITS MINE, Grellkin, get them!","s":["boss_grizikil"]},"60410":{"t":"You-you-you no defeat me, I am strong!","s":["boss_grizikil"]},"60411":{"t":"Orb is mine, no take orb...","s":["boss_grizikil"]},"60412":{"t":"You dare disturb the Dark Rider Lord?","s":["boss_blackwald_ii"]},"60413":{"t":"I call upon the Scythe of Elune, grant me your power!","s":["boss_blackwald_ii"]},"60414":{"t":"Master, this was not fortold, this was not supposed to be my fate...","s":["boss_blackwald_ii"]},"60415":{"t":"So it was you I smelled! Such a foul taint.","s":["boss_clawlord_howlfang"]},"60416":{"t":"My pack shall tear you apart, bone by bone!","s":["boss_clawlord_howlfang"]},"60417":{"t":"You vile, disgusting creatures, how could I lose to you?","s":["boss_clawlord_howlfang"]},"60419":{"t":"My Brood... Destroyed.","s":["boss_brood_queen_araxxna","skitterweb_egg"]},"60420":{"t":"My minions shall consume you!","s":["boss_brood_queen_araxxna","skitterweb_egg"]},"60421":{"t":"What goes there, new prey to be entangled?