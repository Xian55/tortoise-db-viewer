node_modules/
dist/
__pycache__/
*.pyc
# Prerendered OG link-preview stubs (regenerated by scripts/build-og.mjs in CI)
og-stubs/
# Built data (regenerated by scripts/build-db.mjs in CI). Covers every dataset subdir:
# data/ (main), data-dev/ (1181dev), data-vanilla-cmangos/ (matrix rows), etc.
public/data*/*.sqlite
public/data*/*.sqlite-journal
public/data*/version.json
# Per-deploy changelog (built by scripts/build-changelog.mjs, accumulated on R2)
public/data*/changelog.json
# Embed tooltip JSON (regenerated by scripts/build-tooltips.mjs; deploy writes dist/tt)
public/tt/
# Client-derived binary assets (~74 MB / 6.5k files): zone parchments, minimap tile
# pyramids, creature model thumbnails -- per dataset. R2 is their source of truth, not
# git. Pull them with `bun run assets`, publish with scripts/publish-assets.mjs; the
# committed index is scripts/data/assets-manifest.json. See scripts/lib/assets.mjs.
# (public/icons stays IN git: small, and the Pages atlas fallback needs it.)
public/maps*/
public/minimap*/
public/model-thumbs/
*.log
.DS_Store
# Local notes / drafts — never committed
notes/
# Local env files (VITE_* vars etc.) — never commit; secrets live in CI secrets
.env
.env.*
!.env.example

# local wowhead-probe cache (re-generatable; missing.json is the committed artifact)
scripts/data/model-thumb-coverage.json

# local render QC montages (temp)
scratch_cmp/

# Smoke-test persistent Chrome profiles (per-shard OPFS DB cache; downloaded once)
.smoke-cache/

# Lighthouse audit reports (scripts/audit.mjs; regenerated on demand)
.lighthouse/
